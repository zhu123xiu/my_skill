.page-shell {
  padding: 24rpx;
}

.soft-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.protocol-hero {
  text-align: center;
  padding: 64rpx 32rpx;
}

.protocol-hero__icon {
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.protocol-hero__title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.protocol-hero__subtitle {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}
