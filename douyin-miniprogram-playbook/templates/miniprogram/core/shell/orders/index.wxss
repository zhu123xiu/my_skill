.page-shell {
  padding: 24rpx;
}

.orders-intro {
  padding: 18rpx 4rpx 26rpx;
}

.orders-intro__title {
  font-size: 42rpx;
  font-weight: 800;
}

.orders-intro__desc {
  margin-top: 10rpx;
  color: #999;
  font-size: 25rpx;
}

/* Loading skeleton */
.loading-card {
  margin-top: 8rpx;
  padding: 44rpx 34rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.sk-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  animation: pulse 1.5s ease-in-out infinite;
}

.sk-line--wide {
  margin-top: 20rpx;
  width: 60%;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* Error state */
.error-card {
  margin-top: 8rpx;
  padding: 34rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.error-card__text {
  color: #999;
  font-size: 26rpx;
}

.error-card__btn {
  height: 76rpx;
  margin-top: 22rpx;
  border-radius: 22rpx;
  font-size: 27rpx;
  line-height: 76rpx;
}

/* Empty state */
.empty-card {
  margin-top: 8rpx;
  padding: 54rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.empty-card__icon {
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto;
  border-radius: 24rpx;
  background: #eaf1fb;
  color: #6d8fc8;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-card__title {
  margin-top: 18rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.empty-card__desc {
  margin-top: 8rpx;
  color: #aaa;
  font-size: 23rpx;
}

/* Order list */
.orders-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-card {
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.order-card__top,
.order-card__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.order-card__name {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 700;
}

.order-card__status {
  padding: 8rpx 14rpx;
  border-radius: 18rpx;
  background: #eaf7ef;
  color: #3eaa71;
  font-size: 21rpx;
  flex-shrink: 0;
}

.order-card__status--pending,
.order-card__status--processing {
  background: #fff3df;
  color: #ba8841;
}

.order-card__status--failed,
.order-card__status--closed,
.order-card__status--refunded {
  background: #f9e9e5;
  color: #b36b59;
}

.order-card__meta {
  margin-top: 12rpx;
  color: #aaa;
  font-size: 22rpx;
}

.order-card__bottom {
  margin-top: 24rpx;
}

.order-card__price {
  color: #333;
  font-size: 32rpx;
  font-weight: 800;
}

.order-card__after-sale {
  min-width: 136rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border: 2rpx solid #ccc;
  border-radius: 18rpx;
  background: #fff;
  color: #666;
  font-size: 23rpx;
  line-height: 54rpx;
}

/* Compliance policy text */
.orders-policy {
  margin: 26rpx 8rpx 8rpx;
  color: #aaa;
  font-size: 22rpx;
  line-height: 1.6;
}

.primary-btn {
  background: #333;
  color: #fff;
  border: none;
}
