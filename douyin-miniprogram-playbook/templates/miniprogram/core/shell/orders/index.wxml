<view class="page-shell orders-page">
  <view class="orders-intro">
    <view class="orders-intro__title">我的订单</view>
    <view class="orders-intro__desc">查看购买记录与订单状态。</view>
  </view>

  <!-- Loading skeleton -->
  <view wx:if="{{loading}}" class="loading-card">
    <view class="sk-line"></view>
    <view class="sk-line sk-line--wide"></view>
  </view>

  <!-- Error state -->
  <view wx:elif="{{errorMessage}}" class="error-card">
    <view class="error-card__text">{{errorMessage}}</view>
    <button class="primary-btn error-card__btn" bindtap="loadPage">重新加载</button>
  </view>

  <!-- Empty state -->
  <view wx:elif="{{!orders.length}}" class="empty-card">
    <view class="empty-card__icon">单</view>
    <view class="empty-card__title">还没有购买记录</view>
    <view class="empty-card__desc">完成购买后，订单会显示在这里。</view>
  </view>

  <!-- Order list -->
  <view wx:else class="orders-list">
    <view wx:for="{{orders}}" wx:key="outTradeNo" class="order-card">
      <view class="order-card__top">
        <view class="order-card__name">{{item.productName}}</view>
        <view class="order-card__status order-card__status--{{item.statusClass}}">{{item.statusLabel}}</view>
      </view>
      <view class="order-card__meta">下单时间：{{item.createdAtText}}</view>
      <view class="order-card__bottom">
        <view class="order-card__price">¥{{item.displayPrice}}</view>
        <button
          class="order-card__after-sale"
          open-type="im"
          data-im-id="{{imId}}"
          bindim="onByteHiContact"
        >申请售后</button>
      </view>
    </view>
  </view>

  <!-- Compliance text: virtual goods notice -->
  <view class="orders-policy">商品为虚拟内容服务，购买成功后即时开通，一经开通不支持退款；如有疑问请联系客服协商处理。</view>
</view>
