.page-shell {
  padding: 24rpx;
}

.profile-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.profile-card__top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx;
}

.profile-card__avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #e8e0da;
  color: #666;
  font-size: 38rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-card__main {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
}

.profile-card__name {
  font-size: 36rpx;
  font-weight: 700;
}

.menu-card {
  margin-top: 24rpx;
  padding: 10rpx 0;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 28rpx;
}

.menu-item--im {
  position: relative;
}

.menu-item__im-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: normal;
  z-index: 2;
}

.menu-item__im-btn::after {
  border: none;
}

.menu-item__icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: #ccc;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-item__icon--coral { background: #e0a998; }
.menu-item__icon--blue { background: #79acd6; }
.menu-item__icon--gold { background: #d4a843; }
.menu-item__icon--purple { background: #986fc9; }
.menu-item__icon--service { background: #e0a998; }
.menu-item__icon--default { background: #b0b0b0; }

.menu-item__text {
  flex: 1;
}

.menu-item__title {
  font-size: 30rpx;
  font-weight: 700;
}

.menu-item__desc {
  margin-top: 10rpx;
  color: #999;
  font-size: 22rpx;
}

.chevron {
  color: #ccc;
  font-size: 32rpx;
  flex-shrink: 0;
}
