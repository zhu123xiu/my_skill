<view class="page">
  <view class="intro">
    <view class="intro-title">解锁全部课程</view>
    <view class="intro-sub">一次购买，永久学习全部内容与练习。</view>
  </view>

  <view wx:if="{{loading}}" class="tip">加载中…</view>

  <view wx:else class="products">
    <view wx:for="{{products}}" wx:key="itemId" class="product">
      <view class="product-main">
        <view class="product-title">{{item.title}}</view>
        <view wx:if="{{item.desc}}" class="product-desc">{{item.desc}}</view>
      </view>
      <view class="product-right">
        <view class="product-price">{{item.priceLabel}}</view>
        <button
          class="buy-btn {{canBuy ? '' : 'buy-btn--off'}}"
          disabled="{{busy}}"
          data-id="{{item.itemId}}"
          bindtap="onBuy"
        >{{canBuy ? '立即购买' : '暂不支持'}}</button>
      </view>
    </view>
    <view wx:if="{{!products.length}}" class="tip">暂无可购买的商品</view>
  </view>

  <view wx:if="{{!canBuy && buyReason}}" class="notice">{{buyReason}}</view>

  <view class="redeem">
    <view class="redeem-title">已有激活码？</view>
    <input
      class="redeem-input"
      placeholder="请输入激活码"
      value="{{code}}"
      bindinput="onInputCode"
      confirm-type="done"
    />
    <button class="redeem-btn" disabled="{{busy}}" bindtap="onRedeem">兑换</button>
  </view>

  <view class="foot">
    <text class="foot-link" bindtap="goOrders">查看我的订单 ›</text>
  </view>
</view>
