.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f6f6f6;
}

.intro {
  padding: 20rpx 8rpx 30rpx;
}

.intro-title {
  font-size: 42rpx;
  font-weight: 800;
}

.intro-sub {
  margin-top: 10rpx;
  color: #999;
  font-size: 25rpx;
}

.tip {
  padding: 40rpx 0;
  color: #aaa;
  font-size: 26rpx;
  text-align: center;
}

.products {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.product {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.product-main {
  flex: 1;
  min-width: 0;
}

.product-title {
  font-size: 30rpx;
  font-weight: 700;
}

.product-desc {
  margin-top: 8rpx;
  color: #999;
  font-size: 23rpx;
}

.product-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

.product-price {
  font-size: 36rpx;
  font-weight: 800;
  color: #333;
}

.buy-btn {
  min-width: 168rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  border: none;
  border-radius: 20rpx;
  background: #333;
  color: #fff;
  font-size: 26rpx;
  line-height: 64rpx;
}

.buy-btn::after {
  border: none;
}

.buy-btn--off {
  background: #ccc;
  color: #fff;
}

.notice {
  margin: 24rpx 8rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #fff3df;
  color: #ba8841;
  font-size: 24rpx;
}

.redeem {
  margin-top: 40rpx;
  padding: 30rpx 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.redeem-title {
  font-size: 28rpx;
  font-weight: 700;
}

.redeem-input {
  height: 80rpx;
  margin: 20rpx 0;
  padding: 0 22rpx;
  border: 2rpx solid #eee;
  border-radius: 20rpx;
  background: #fafafa;
  font-size: 28rpx;
}

.redeem-btn {
  height: 76rpx;
  border-radius: 22rpx;
  background: #333;
  color: #fff;
  font-size: 27rpx;
  line-height: 76rpx;
}

.redeem-btn::after {
  border: none;
}

.foot {
  margin-top: 30rpx;
  text-align: center;
}

.foot-link {
  color: #999;
  font-size: 25rpx;
}
