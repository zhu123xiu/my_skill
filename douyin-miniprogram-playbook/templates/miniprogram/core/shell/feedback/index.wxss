.page-shell {
  padding: 24rpx;
}

.feedback-intro {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.feedback-intro__mark {
  width: 82rpx;
  height: 82rpx;
  border-radius: 24rpx;
  background: #b0b0b0;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feedback-intro__copy {
  flex: 1;
}

.feedback-intro__title {
  font-size: 34rpx;
  font-weight: 800;
}

.feedback-intro__desc {
  margin-top: 8rpx;
  color: #999;
  font-size: 24rpx;
  line-height: 1.5;
}

.feedback-form {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.feedback-form__title {
  font-size: 30rpx;
  font-weight: 700;
}

.feedback-categories {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.feedback-category {
  padding: 12rpx 22rpx;
  border-radius: 24rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
}

.feedback-category--active {
  background: #333;
  color: #ffffff;
  font-weight: 700;
}

.feedback-textarea {
  width: 100%;
  min-height: 220rpx;
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f9f9f9;
  color: #333;
  font-size: 26rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.feedback-contact {
  width: 100%;
  height: 76rpx;
  margin-top: 16rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: #f9f9f9;
  color: #333;
  font-size: 25rpx;
  box-sizing: border-box;
}

.feedback-submit {
  height: 82rpx;
  margin-top: 22rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  background: #333;
  color: #fff;
  border: none;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 42rpx;
  padding: 0 4rpx;
}

.section-heading__left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-heading__bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: #333;
}

.section-heading__title {
  font-size: 30rpx;
  font-weight: 700;
}

.section-heading__action {
  color: #999;
  font-size: 24rpx;
}

/* Loading skeleton */
.loading-card {
  margin-top: 8rpx;
  padding: 44rpx 34rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.sk-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  animation: pulse 1.5s ease-in-out infinite;
}

.sk-line--wide {
  margin-top: 20rpx;
  width: 60%;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* Error */
.error-card {
  margin-top: 8rpx;
  padding: 34rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  color: #999;
  font-size: 26rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* Empty */
.feedback-empty {
  margin-top: 8rpx;
  padding: 46rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.feedback-empty__icon {
  color: #ccc;
  font-size: 40rpx;
}

.feedback-empty__title {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.feedback-empty__desc {
  margin-top: 8rpx;
  color: #aaa;
  font-size: 23rpx;
}

/* Feedback list */
.feedback-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feedback-card {
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.feedback-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.feedback-card__category {
  color: #333;
  font-size: 25rpx;
  font-weight: 700;
}

.feedback-card__status {
  padding: 8rpx 14rpx;
  border-radius: 18rpx;
  background: #fff3df;
  color: #ba8841;
  font-size: 21rpx;
}

.feedback-card__status--replied {
  background: #eaf7ef;
  color: #3eaa71;
}

.feedback-card__time,
.feedback-card__contact,
.feedback-card__reply-time {
  margin-top: 10rpx;
  color: #aaa;
  font-size: 21rpx;
}

.feedback-card__content {
  margin-top: 18rpx;
  color: #555;
  font-size: 27rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.feedback-card__reply {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #f9f9f9;
}

.feedback-card__reply-label {
  color: #333;
  font-size: 23rpx;
  font-weight: 700;
}

.feedback-card__reply-text {
  margin-top: 8rpx;
  color: #555;
  font-size: 25rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.feedback-card__pending {
  margin-top: 18rpx;
  color: #aaa;
  font-size: 23rpx;
}
